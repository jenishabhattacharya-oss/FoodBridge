# Development settings (config.settings)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-for-non-development-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production settings (config.settings_production)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_MEDIA_ROOT=/var/data/media

# Optional: required only if external payments are enabled.
FOODBRIDGE_PAYMENTS_ENABLED=false
PAYMENT_ENCRYPTION_KEY=replace-with-a-long-random-value
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_OAUTH_CLIENT_ID=
RAZORPAY_OAUTH_CLIENT_SECRET=
RAZORPAY_OAUTH_REDIRECT_URI=https://your-domain.example/payments/ngo/oauth/callback/
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=

# Optional: required for visual food screening.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_TEXT_MODEL=gemini-3.6-flash

# Optional: required for password reset e-mails.
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=noreply@your-domain.example
